@model JodhpurPalace.Models.Hotel

@{
    ViewData["Title"] = "Booking List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("bookingList", "Home", FormMethod.Post, new { @enctype = "multipart/form-data" }))
{
<h2 style="color:black"><b>Booking List</b></h2>

<h4 style="color:black">Jodhpur Palace</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="bookingList">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RoomId" class="control-label"></label>
                <input asp-for="RoomId" class="form-control" />
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomName" class="control-label"></label>
                <input asp-for="RoomName" class="form-control" />
                <span asp-validation-for="RoomName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomType" class="control-label"></label>
                <input asp-for="RoomType" class="form-control" />
                <span asp-validation-for="RoomType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Available" class="control-label"></label>
                <input asp-for="Available" class="form-control" />
                <span asp-validation-for="Available" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="file" name="FormFile" title="Upload Image" />
            </div>




            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-success" />
                <input class="btn btn-danger" type="reset" value="Reset">
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="MyHotels1">Back to List</a>
</div>
}
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
