@model IEnumerable<JodhpurPalace.Models.Hotel>

@{
    ViewData["Title"] = "Jodhpur Palace Booking Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<body style="background-image:url(https://static.zingyhomes.com/projectImages/cache/a3/11/a3116c61fde453fb9dc4399e3eadbb85.jpg); background-repeat: no-repeat; background-size:1280px 790px;">*@

    <h2 style="color:black"><b>Booking Details</b></h2>

    <p>
        <a asp-action="bookingListCreate">Add New Rooms</a>
    </p>
    <table class="table">
        <thead>
            <tr style="color:black; font-size:20px">
                <th hidden>
                    @Html.DisplayNameFor(model => model.RoomId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RoomName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RoomType)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Price)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Available)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Images)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
            <tr>
                <td hidden>
                    @Html.DisplayFor(modelItem => item.RoomId)
                </td>
                <td style="color:black;font-size:15px">
                    <b>
                        @Html.DisplayFor(modelItem => item.RoomName)
                    </b>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RoomType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Available)
                </td>
                <td>
                    <a target="_blank" href="~/@item.Images">
                        <img src="~/@item.Images" alt="Rooms" height=100 width=200 class="image" />
                    </a>
                </td>
                <td>
                    @Html.ActionLink("Edit", "bookingList", new { id = item.RoomId }) |
                    @*@Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |*@
                    @Html.ActionLink("Delete", "DeletebookingList", new { id = item.RoomId })
                </td>
            </tr>
            }
        </tbody>
    </table>
    <a asp-action="MyList">Back</a>
