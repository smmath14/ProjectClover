@model IEnumerable<JodhpurPalace.Models.Hotel>

@{
    ViewData["Title"] = "The Royal Jodhpur Palace";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="color:black">The Royal Jodhpur Palace</h2>

<h6>*All Prices are in Indian Rupee(₹)</h6>
<table class="table">
    <thead>
        <tr style="color:black; font-size:18px">
            <th hidden>
                @Html.DisplayNameFor(model => model.RoomId)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.RoomName)

            </th>
            <th>

            </th>
            <th hidden>
                @Html.DisplayNameFor(model => model.Images)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)

            </th>
            @*<th>
            @Html.DisplayNameFor(model => model.Available)
        </th>*@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr style="color:black">
            <td hidden>
                @Html.DisplayFor(modelItem => item.RoomId)
            </td>

            <td style="color:black; font-size:18px">
                @Html.DisplayFor(modelItem => item.RoomName)


            </td>

            <td>
                <a target="_blank" href="~/@item.Images">
                    <img src="~/@item.Images" alt="Rooms" height=200 width=300 class="image" />
                </a>
            </td>


            <td>
                @Html.DisplayFor(modelItem => item.RoomType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)<br />
                <p style="font-size:9px; color:black"><b>Starting Rates/Night</b></p>
            </td>
            @*<td>
            @Html.DisplayFor(modelItem => item.Available)
        </td>*@
            <td>
                @Html.ActionLink("BookNow", "GuestCart", new { id = item.RoomId })



                @*<img src="@Model.CartItems[i].Product.Image" alt="@Model.CartItems[i].Product.Name" />*@



            </td>
        </tr>
        }
    </tbody>
</table>
<a asp-action="GCreate">Back</a>
