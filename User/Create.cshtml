@model JodhpurPalace.Models.User

@{
    ViewData["Title"] = "Login Here";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 style="color:black"><b>User Login</b></h2>

    


<body style="background-image:url(https://img.traveltriangle.com/blog/wp-content/uploads/2018/11/umaid-bhawan-beautifully-decorated.jpg); background-repeat: no-repeat; background-size:1500px 790px;">

    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @*div class="form-group" hidden>
                        <label asp-for="Id" class="control-label"></label>
                        <input asp-for="Id" class="form-control" required />
                        <span asp-validation-for="Id" class="text-danger"></span>
                    </div>*@

                <div class="form-group">
                    <label asp-for="Username" class="control-label"></label>
                    <input asp-for="Username" class="form-control" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Login" class="btn btn-success" />
                    @*<input class="btn btn-danger" type="reset" value="Reset">*@
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-controller="Home" asp-action="Index">Return To Home</a>
        <a style="padding-left:20px" asp-controller="User" asp-action="NewUser">Register Here</a>
    </div>
</body>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
